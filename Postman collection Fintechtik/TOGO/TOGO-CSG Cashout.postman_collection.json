				{
					"name": "InitiateGlobalCashout (MMT)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Get current date-time\r",
									"const now = new Date();\r",
									"\r",
									"// Format function\r",
									"function formatDate(date) {\r",
									"    const yyyy = date.getFullYear();\r",
									"    const MM = String(date.getMonth() + 1).padStart(2, '0');\r",
									"    const dd = String(date.getDate()).padStart(2, '0');\r",
									"    const HH = String(date.getHours()).padStart(2, '0');\r",
									"    const mm = String(date.getMinutes()).padStart(2, '0');\r",
									"    const ss = String(date.getSeconds()).padStart(2, '0');\r",
									"    return `${yyyy}-${MM}-${dd} ${HH}:${mm}:${ss}`;\r",
									"}\r",
									"\r",
									"// Set transaction_date to now\r",
									"const transactionDate = formatDate(now);\r",
									"\r",
									"// Set expiry_date to 1 month and 5 days from now\r",
									"const expiry = new Date(now);\r",
									"expiry.setMonth(expiry.getMonth() + 1);\r",
									"expiry.setDate(expiry.getDate() + 5);\r",
									"const expiryDate = formatDate(expiry);\r",
									"\r",
									"// Generate unique merchant_ref (prefix + timestamp)\r",
									"const merchantRef = 'yogupay' + Date.now().toString(36);\r",
									"\r",
									"// Set environment or collection variables\r",
									"pm.variables.set(\"transaction_date\", transactionDate);\r",
									"pm.variables.set(\"expiry_date\", expiryDate);\r",
									"pm.variables.set(\"merchant_ref\", merchantRef);\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
