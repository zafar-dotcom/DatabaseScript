		{
			"name": "Create OTA Request",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Base numbers with fixed status prefix\r",
							"const baseNumbers = [\r",
							"    \"+23314486\", // SUCCESS\r",
							"    \"+23324486\", // Time out\r",
							"    \"+23334486\", // Failed\r",
							"    \"+23344486\"  // Internal Error\r",
							"];\r",
							"\r",
							"// Pick one status randomly\r",
							"let base = baseNumbers[Math.floor(Math.random() * baseNumbers.length)];\r",
							"\r",
							"// Generate random 3-4 digit suffix\r",
							"let suffix = Math.floor(1000 + Math.random() * 9000); // 4 digits\r",
							"let selectedMobile = base + suffix;\r",
							"\r",
							"// Save mobile into Postman global\r",
							"pm.globals.set(\"Mobile\", selectedMobile);\r",
							"\r",
							"// Generate a random Frequency (Monthly, Weekly, Daily, Yearly)\r",
							"const frequencies = [\"MONTHLY\", \"WEEKLY\", \"DAILY\", \"YEARLY\"];\r",
							"let randomFrequency = frequencies[Math.floor(Math.random() * frequencies.length)];\r",
							"pm.globals.set(\"Frequency\", randomFrequency);\r",
							"\r",
							"// Get today's date in YYYY-MM-DD format\r",
							"let today = new Date();\r",
							"let todayStr = today.toISOString().split(\"T\")[0] + \"T00:00:00\";\r",
							"pm.globals.set(\"StartDate\", todayStr);\r",
							"\r",
							"// Get end date (1 year later)\r",
							"let endDate = new Date();\r",
							"endDate.setFullYear(endDate.getFullYear() + 1);\r",
							"let endDateStr = endDate.toISOString().split(\"T\")[0] + \"T00:00:00\";\r",
							"pm.globals.set(\"EndDate\", endDateStr);\r",
							"\r",
							"// Generate a random OrderId (16-digit random number)\r",
							"let randomOrderId = Math.floor(1000000000000000 + Math.random() * 9000000000000000).toString();\r",
							"pm.globals.set(\"OrderId\", randomOrderId);\r",
							"\r",
							"// Generate a random Description\r",
							"const descriptions = [\r",
							"    \"Subscription for premium service\",\r",
							"    \"Payment for monthly package\",\r",
							"    \"Weekly renewal of streaming service\",\r",
							"    \"Yearly gym membership renewal\",\r",
							"    \"Mobile data plan subscription\"\r",
							"];\r",
							"let randomDescription = descriptions[Math.floor(Math.random() * descriptions.length)];\r",
							"pm.globals.set(\"Description\", randomDescription);\r",
							"\r",
							"// Log values in Postman Console for debugging\r",
							"console.log(\"Selected Mobile:\", selectedMobile);\r",
							"console.log(\"Generated Frequency:\", randomFrequency);\r",
							"console.log(\"Start Date:\", todayStr);\r",
							"console.log(\"End Date:\", endDateStr);\r",
							"console.log(\"Generated OrderId:\", randomOrderId);\r",
							"console.log(\"Generated Description:\", randomDescription);\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
