                  "        console.log('RTP ID saved: ' + jsonData.thirdPartyResponse.data.rtpID);",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"Status is PENDING\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.thirdPartyResponse && jsonData.thirdPartyResponse.data) {",
