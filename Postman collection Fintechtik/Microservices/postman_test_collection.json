    {
      "name": "2. Token Generation",
      "item": [
        {
          "name": "Generate Gmoney Token - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has microservice status\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('microserviceStatus');",
                  "    pm.expect(jsonData.microserviceStatus).to.equal('Request successfully processed');",
                  "});",
                  "",
                  "pm.test(\"Response has third party response\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('thirdPartyResponse');",
                  "    pm.expect(jsonData.thirdPartyResponse).to.have.property('data');",
                  "});",
                  "",
                  "pm.test(\"Token data exists\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.thirdPartyResponse && jsonData.thirdPartyResponse.data) {",
                  "        pm.expect(jsonData.thirdPartyResponse.data).to.have.property('access_Token');",
                  "        console.log('Gmoney Token: ' + jsonData.thirdPartyResponse.data.access_Token);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/gmoney/token",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "gmoney", "token"]
            },
            "description": "Generate authentication token from Gmoney API"
          },
          "response": []
        },
