                              SELECT 
    c.rule_id AS rule_id,
    c.description AS description,
    m.mobile_network_code AS mobile_network_code,
    e.entity_code AS entity_code,
    c.pm_provider_entity_id AS pm_provider_entity_id,
    c.network_entity AS network_entity
FROM 
    REMIT_ENTITY_PROCESS_CONFIG c
JOIN 
    mobile_network m ON c.network_entity = m.entity_id
JOIN 
    entity e ON e.entity_id = c.pm_provider_entity_id
WHERE 
    c.merchant_entity_id is null;



